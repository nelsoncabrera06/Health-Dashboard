# Copy to .env for local development. Never commit .env.

# ── Supabase (obligatorias) ───────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: chat, API v1, MCP, gestión de keys y borrado de cuenta.
# Nunca llega al cliente. Si se filtra, hay que rotarla en Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# ── Chat con IA (solo servidor) ───────────────────────────────
# OJO: esto es solo el DEFAULT. El modelo activo se elige en /admin (admin) y se
# guarda en la tabla `app_settings`; el chat lee eso primero y cae acá si no hay
# fila. Cambiar de modelo ya no requiere redeploy.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# Con un modelo con visión, OpenRouter también acepta fotos (ver lib/aiCatalog.js).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Notas de voz: el audio se transcribe con un STT aparte (lib/stt.js) y el texto
# entra al modelo elegido, así que la voz funciona con cualquier provider.
# Groq (OpenAI-compatible), mismo setup que el agente Pepe/OpenClaw. El tier
# gratuito alcanza de sobra para notas de 30s.
GROQ_API_KEY=
# Opcional: whisper-large-v3-turbo (default) o whisper-large-v3.
GROQ_STT_MODEL=

# ── Notificaciones de usuarios nuevos (resumen diario) ────────
# Switch y frecuencia: /admin → Notificaciones. El cron de Supabase llama a
# /api/cron/signup-digest una vez por día (10:00 ART) con x-cron-secret.
# Resend: en modo test solo puede mandar a la casilla de la cuenta.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
# Opcional: remitente. Default: "Nutrition Dashboard <onboarding@resend.dev>"
NOTIFY_EMAIL_FROM=
# Mismo valor que el secreto guardado en Supabase Vault (signup_digest_secret).
SIGNUP_DIGEST_SECRET=
# Base para el link "Ver en el panel" del email.
NEXT_PUBLIC_APP_URL=https://nutritiondashboard.vercel.app

# ── Cuenta demo pública (opcional) ────────────────────────────
# El botón "Probar demo" del login solo aparece si están las dos.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# ── Opcional ──────────────────────────────────────────────────
# Base con la que se arman los snippets de MCP que muestra /api-keys.
# Si falta, usa el origin del request (o prod como último recurso).
NEXT_PUBLIC_SITE_URL=

# ── Solo para scripts/CLI (no lo usa la app) ──────────────────
# Supabase → Settings → Database → Connection string (psql, migraciones).
# DATABASE_URL=
