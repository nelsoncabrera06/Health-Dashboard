# Copy to .env for local dev (never commit .env)
PORT=3000
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Solo servidor (ruta admin), nunca al cliente:
# SUPABASE_SERVICE_ROLE_KEY=
# AI chat (solo servidor): AI_PROVIDER=openrouter|gemini + la key y el modelo de cada uno.
# AI_PROVIDER=, OPENROUTER_API_KEY=, OPENROUTER_MODEL=, GEMINI_API_KEY=, GEMINI_MODEL=
# (cambiar de proveedor = editar AI_PROVIDER + reiniciar `npm run dev`)
# Cuenta demo pública (botón "Probar demo" en el login; se muestra solo si están las dos):
# NEXT_PUBLIC_DEMO_EMAIL=demo@health.local
# NEXT_PUBLIC_DEMO_PASSWORD=
# DATABASE_URL=postgresql://postgres:[DB-PASSWORD]@db.[REF].supabase.co:5432/postgres  # solo si usás psql/CLI (Settings → Database → URI)
